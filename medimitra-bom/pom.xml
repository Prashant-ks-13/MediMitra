<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.medimitra</groupId>
    <artifactId>medimitra-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>medimitra-bom</artifactId>
  <packaging>pom</packaging>

  <name>medimitra-bom</name>
  <description>Dependency version management for all MediMitra modules and services</description>

  <properties>
    <spring-boot.version>3.3.5</spring-boot.version>
    <spring-cloud.version>2023.0.3</spring-cloud.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <testcontainers.version>1.20.2</testcontainers.version>
    <medimitra.version>0.1.0-SNAPSHOT</medimitra.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.medimitra</groupId>
        <artifactId>medimitra-common-core</artifactId>
        <version>${medimitra.version}</version>
      </dependency>
      <dependency>
        <groupId>com.medimitra</groupId>
        <artifactId>medimitra-common-contracts</artifactId>
        <version>${medimitra.version}</version>
      </dependency>
      <dependency>
        <groupId>com.medimitra</groupId>
        <artifactId>medimitra-common-messaging</artifactId>
        <version>${medimitra.version}</version>
      </dependency>
      <dependency>
        <groupId>com.medimitra</groupId>
        <artifactId>medimitra-common-security</artifactId>
        <version>${medimitra.version}</version>
      </dependency>
      <dependency>
        <groupId>com.medimitra</groupId>
        <artifactId>medimitra-common-web</artifactId>
        <version>${medimitra.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
